# Local OSS-substrate wiring for reporium-audit. Copy to `.env` (`make seed`
# does this for you). All values point at the local substitutes -- no real
# cloud endpoints, no secrets.

# reporium-api OSS substitute (nginx). The hostname is a Docker network alias
# for the substrate container.
REPORIUM_API_URL=https://reporium-api.local

# The audit requires a non-empty GH_TOKEN. The local api.github.com substitute
# ignores auth entirely, so any placeholder works -- DO NOT put a real token.
GH_TOKEN=local-substrate-no-auth
